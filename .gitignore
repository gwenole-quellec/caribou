# CARIBOU — local data, simulation outputs, and Python artifacts
# =============================================================

# Python caches and environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/
build/
dist/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
*~

# Local research-travel data (not for public distribution)
*.xlsx
*.xls
*.xlsm

